# Copia este archivo como .env y llena los valores. NUNCA subas el .env a git.

# Token de acceso de la API de WhatsApp (temporal o permanente de usuario del sistema)
META_ACCESS_
# Identificador del número de teléfono (Phone number ID) en WhatsApp → API Setup
META_PHONE_NUMBER_ID=1382903028236350
# Texto secreto que tú inventas; debe ser el mismo que pongas en la configuración del webhook en Meta
META_VERIFY_TOKEN=unimedicas_bot_2026_x9k2
# Clave secreta de la app (App settings → Basic → App secret)
META_APP_SECRET=bc3533240ba196cf86b443df004c5aba
# Versión de la Graph API
META_API_VERSION=v25.0
# (Opcional) URL pública del logo para la bienvenida. Si queda vacía, la bienvenida se envía como texto.
WELCOME_IMAGE_URL=
# Puerto del servidor
PORT=3000
